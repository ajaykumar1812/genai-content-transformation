# =================================================================
# ENVIRONMENT CONFIGURATION - GEN AI CONTENT TRANSFORMATION PLATFORM
# =================================================================
# Copy this file to .env and provide your secret keys.
# NEVER commit or share your .env file or API keys.

# Flask Application Secret Key (Used for session encryption)
SECRET_KEY=generate-a-secure-random-key-here-for-production

# MongoDB Database Configuration
# Default local instance: mongodb://localhost:27017/
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=genai_content_transformation

# Google Gemini API Configuration (Recommended)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Configuration (Optional alternative provider)
# Obtain your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
