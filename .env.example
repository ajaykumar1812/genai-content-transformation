# ==============================================================================
# GEN AI PLATFORM FOR AUTOMATED CONTENT TRANSFORMATION
# PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Duplicate this file as '.env' in the project root:
#    copy .env.example .env (Windows) or cp .env.example .env (macOS/Linux)
# 2. Paste your real API keys below.
# 3. NEVER commit your '.env' file to Git or share it publicly.

# --- Core Flask Security & Networking ---
# Replace with a cryptographically secure 32+ character random secret key for production:
SECRET_KEY=genai-secure-content-transformation-jwt-session-key-2026
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# --- MongoDB Database Persistence ---
# Local Development: mongodb://localhost:27017/
# Render / Cloud Production: Use your MongoDB Atlas cluster connection string:
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=genai_content_transformation
MONGO_TIMEOUT_MS=5000

# --- Google Gemini AI API (Recommended Default) ---
# Obtain your free Gemini API key at: https://aistudio.google.com/app/apikey
# Supported Models: gemini-3.6-flash (recommended active), gemini-3.5-flash, gemini-3.8-flash (20 req/day limit)
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI API (Alternative Provider) ---
# Obtain your OpenAI API key at: https://platform.openai.com/api-keys
# Supported Models: gpt-4o-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# --- Rate Limiting & Safety Limits ---
RATE_LIMIT_PER_MINUTE=60
MAX_CONTENT_LENGTH=15728640
